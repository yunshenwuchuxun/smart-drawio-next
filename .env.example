# Configure LLM credentials in the browser settings.
# ACCESS_PASSWORD and SERVER_LLM_* are not implemented in the current release.
# Allow local/internal model endpoints for model-list and connection checks
# only when running in a trusted, self-hosted environment.
# ALLOW_LOCAL_LLM_BASE_URLS=true

# Docker notes (optional)
# - Default docker-compose.yml keeps proxy/TLS settings disabled for portability.
# - If Docker must use a local proxy or access a host-local LLM endpoint,
#   copy docker-compose.override.example.yml to docker-compose.override.yml
#   and adjust it for the current machine.



