<mxfile>
  <diagram id="research-architecture" name="科研结构图">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="520">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="方法结构示例：输入、表示与输出" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Arial;fontSize=16;fontStyle=1;">
          <mxGeometry as="geometry" x="40" y="20" width="880" height="40" />
        </mxCell>
        <mxCell id="data-group" value="输入与预处理" vertex="1" parent="1" style="swimlane;html=1;startSize=40;fillColor=#F7F9FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=14;">
          <mxGeometry as="geometry" x="40" y="90" width="230" height="220" />
        </mxCell>
        <mxCell id="input" value="原始输入" vertex="1" parent="data-group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="30" y="60" width="170" height="50" />
        </mxCell>
        <mxCell id="preprocess" value="数据预处理" vertex="1" parent="data-group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="30" y="140" width="170" height="50" />
        </mxCell>
        <mxCell id="model-group" value="表示与任务模块" vertex="1" parent="1" style="swimlane;html=1;startSize=40;fillColor=#F7F9FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=14;">
          <mxGeometry as="geometry" x="340" y="90" width="260" height="220" />
        </mxCell>
        <mxCell id="encoder" value="表示编码器" vertex="1" parent="model-group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="40" y="60" width="180" height="50" />
        </mxCell>
        <mxCell id="head" value="任务输出模块" vertex="1" parent="model-group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="40" y="140" width="180" height="50" />
        </mxCell>
        <mxCell id="output" value="任务输出" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="720" y="230" width="180" height="50" />
        </mxCell>
        <mxCell id="objective" value="训练目标（按需修改）" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="720" y="110" width="180" height="60" />
        </mxCell>
        <mxCell id="input-preprocess" value="" edge="1" parent="data-group" source="input" target="preprocess" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="data-encoder" value="预处理数据" edge="1" parent="1" source="preprocess" target="encoder" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="encoder-head" value="" edge="1" parent="model-group" source="encoder" target="head" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="head-output" value="" edge="1" parent="1" source="head" target="output" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="output-objective" value="训练时" edge="1" parent="1" source="output" target="objective" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;dashed=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="图例：实线 = 数据流；虚线 = 训练/辅助关系。示例模块需按实际方法替换。" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" x="40" y="370" width="860" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
