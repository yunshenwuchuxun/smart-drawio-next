<mxfile>
  <diagram id="decision-flow" name="分支流程图">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="700" pageHeight="780">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始" vertex="1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="220" y="40" width="160" height="60" />
        </mxCell>
        <mxCell id="prepare" value="准备输入" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="220" y="150" width="160" height="60" />
        </mxCell>
        <mxCell id="decision" value="输入有效？" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="210" y="270" width="180" height="100" />
        </mxCell>
        <mxCell id="process" value="执行处理" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="220" y="440" width="160" height="60" />
        </mxCell>
        <mxCell id="fix-input" value="返回并修正输入" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="460" y="290" width="180" height="60" />
        </mxCell>
        <mxCell id="end" value="结束" vertex="1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#2C3E50;fontFamily=Arial;fontSize=12;">
          <mxGeometry as="geometry" x="220" y="590" width="160" height="60" />
        </mxCell>
        <mxCell id="start-prepare" value="" edge="1" parent="1" source="start" target="prepare" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="prepare-decision" value="" edge="1" parent="1" source="prepare" target="decision" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="yes" value="是" edge="1" parent="1" source="decision" target="process" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="no" value="否" edge="1" parent="1" source="decision" target="fix-input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="retry" value="" edge="1" parent="1" source="fix-input" target="prepare" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;exitX=0.5;exitY=0;entryX=1;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="process-end" value="" edge="1" parent="1" source="process" target="end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#2C3E50;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=11;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
